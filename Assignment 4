      "source": [
        "# 1. Create a line plot showing the monthly attendance.\n",
        "# 2. Add an appropriate title, X-axis label, and Y-axis label.\n",
        "# 3. Display markers for each month’s attendance.\n",
        "# 4. Add grid lines and a legend.\n",
        "\n",
        "plt.figure(figsize=(12, 6)) # Set a good figure size\n",
        "plt.plot(months, attendance, marker='o', linestyle='-', color='brown', label='Monthly Attendance')\n",
        "\n",
        "plt.title('Monthly Student Attendance Percentage', fontsize=16)\n",
        "plt.xlabel('Month', fontsize=12)\n",
        "plt.ylabel('Attendance (%)', fontsize=12)\n",
        "\n",
        "plt.xticks(rotation=45, ha='right') # Rotate month labels for better readability\n",
        "plt.grid(True, linestyle='--', alpha=0.7)\n",
        "plt.legend()\n",
        "\n",
        "# 5. Highlight the month having the highest attendance.\n",
        "max_attendance = max(attendance)\n",
        "max_month_index = attendance.index(max_attendance)\n",
        "max_month = months[max_month_index]\n",
        "\n",
        "plt.plot(max_month, max_attendance, marker='X', markersize=10, color='darkgreen', label=f'Highest Attendance ({max_month})')\n",
        "plt.annotate(f'{max_attendance}%', (max_month, max_attendance), textcoords=\"offset points\", xytext=(0,10), ha='center', color='red')\n",
        "\n",
        "# 6. Display the average attendance using a horizontal reference line.\n",
        "average_attendance = np.mean(attendance)\n",
        "plt.axhline(y=average_attendance, color='green', linestyle='--', label=f'Average Attendance ({average_attendance:.2f}%)')\n",
        "plt.annotate(f'Average: {average_attendance:.2f}%', (len(months) - 1, average_attendance), textcoords=\"offset points\", xytext=(0, -15), ha='right', color='green')\n",
        "\n",
        "plt.legend()\n",
        "plt.tight_layout() # Adjust layout to prevent labels from being cut off\n",
        "plt.show()"
      ],
